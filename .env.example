# Copy to .env and fill in. Never commit the real file.
# Point this at the least-privilege WebLogic service account, never the domain administrator.
WLS_BASE_URL=http://localhost:7001
WLS_USERNAME=wlsmcp
WLS_PASSWORD=

# Optional guardrails
# WLS_ALLOWED_SERVERS=ms1          # comma-separated allowlist; unset means every server in the domain
# WLS_READ_ONLY=false              # true disables control_server entirely
# WLS_ALLOW_ADMIN_SHUTDOWN=false   # default false. true permits stopping the AdminServer (still needs confirm=true)
# WLS_DESTRUCTIVE_TOKEN=           # break-glass secret. When set, EVERY control_server action also
#                                  # requires a matching token argument. Unlike confirm=true, a model
#                                  # cannot set this itself - only a human can supply it.
# WLS_ADMIN_SERVER_NAME=AdminServer
# WLS_VERIFY_TLS=true              # set false only against a demo certificate
# WLS_TIMEOUT_SECONDS=30
# WLS_LIFECYCLE_TIMEOUT_SECONDS=180
# WLS_AUDIT_LOG=/var/log/wls-mcp/audit.jsonl
# WLS_LOG_LEVEL=INFO

# Transport (also settable with --transport/--host/--port)
# WLS_MCP_TRANSPORT=stdio          # or streamable-http
# WLS_MCP_HOST=127.0.0.1
# WLS_MCP_PORT=8765
